# Copy to .env and adjust. All values shown are the built-in defaults.

# Raw-TCP game socket the client connects to.
# Host to bind (empty = all interfaces, e.g. 0.0.0.0). Set to 127.0.0.1 for local-only.
ROM_GAME_HOST=
ROM_GAME_PORT=17701

# rom-api region service, used to validate a client's sessionKey.
ROM_REGION_URL=http://127.0.0.1:8002
# Use single-use (consume) session validation instead of reusable GET.
ROM_CONSUME_SESSION=false

# Postgres DSN.
ROM_DATABASE_URL=postgres://rom:rom@127.0.0.1:5432/rom?sslmode=disable

# World this instance hosts (must match the session's world).
ROM_WORLD_ID=1

# World simulation tick rate (Hz).
ROM_TICK_HZ=20

# Log level: debug | info | warn | error. debug prints a per-message recv trace.
ROM_LOG_LEVEL=info
